---
// 热力图格子网格 + GitHub 那种跟手的 tooltip。
// 整页 /focus（26 周、带月份标签）和侧栏 widget（14 周、无标签）共用这一个组件 ——
// 原本两边各写一遍 grid，改 tooltip 就得改两处，很容易只改一处然后两边行为不一样。
// tooltip 本身在 FocusTip.astro 里，/focus 整页的 Svelte 仪表盘也引它。
import {
	type HeatCell,
	cellStyle,
	formatTooltip,
	levelOf,
} from "../../../utils/focus-heatmap";
import FocusTip from "./FocusTip.astro";

interface Props {
	cells: HeatCell[];
	maxMinutes: number;
	weeks: number;
	/** 格子间距：整页 3px，侧栏窄，2px */
	gap?: string;
	/** 给了才渲染月份行；侧栏不需要 */
	monthLabels?: { col: number; label: string }[];
}

const { cells, maxMinutes, weeks, gap = "3px", monthLabels } = Astro.props;
---

<div class="focus-heatmap">
	{
		monthLabels && (
			<div
				class="grid mb-1 relative h-4"
				style={`gap:${gap};grid-template-columns:repeat(${weeks},1fr)`}
			>
				{monthLabels.map((m) => (
					<span
						class="text-[10px] text-black/40 dark:text-white/40 absolute"
						style={`left:calc(${m.col} / ${weeks} * 100%)`}
					>
						{m.label}
					</span>
				))}
			</div>
		)
	}
	<div
		class="grid grid-flow-col"
		style={`gap:${gap};grid-template-rows:repeat(7,1fr);grid-template-columns:repeat(${weeks},1fr)`}
	>
		{
			cells.map((c) => (
				<div
					class="aspect-square rounded-[2px] focus-cell"
					style={cellStyle(levelOf(c.minutes, maxMinutes))}
					data-tip={formatTooltip(c)}
				/>
			))
		}
	</div>
</div>
<FocusTip />
