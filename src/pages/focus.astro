---
import FocusDashboard from "../components/widgets/focus/dashboard/FocusDashboard.svelte";
import FocusTip from "../components/widgets/focus/FocusTip.astro";
import { siteConfig } from "../config";
import { focusStats } from "../data/focus-stats";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { keyOf } from "../utils/focus-heatmap";

export const prerender = true;

if (!siteConfig.featurePages.focus) {
	return Astro.redirect("/404/");
}

const { totalSessions, updatedAt } = focusStats;

// 「今天」在构建期定死传给 Svelte：这个组件服务端和浏览器各渲染一遍，
// 两边各自 new Date() 可能不是同一天，26 周热力图的右端就会错开一周。
// 数据本身只能随一次同步 + 重新构建而变，所以构建日期就是数据的「今天」。
const todayKey = keyOf(new Date());

const updatedLabel = updatedAt
	? new Date(updatedAt).toLocaleDateString("zh-CN", {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	: null;
---

<MainGridLayout
	title="专注统计"
	description="按天记录的专注时长：热力图、日视图时间轴、周月年统计"
>
	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<div class="flex flex-col items-start justify-center mb-6">
				<h1
					class="text-3xl sm:text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)] before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
				>
					🎯 专注统计
				</h1>
				<p
					class="text-black/50 dark:text-white/50 text-sm sm:text-base"
				>
					{
						updatedLabel
							? `最后更新于 ${updatedLabel}`
							: "还没有同步过数据"
					}
				</p>
			</div>

			{
				totalSessions === 0 ? (
					<p class="text-center text-black/40 dark:text-white/40 text-sm py-10">
						数据还是空的——去 Obsidian
						私有笔记里点「同步到博客公开统计页」试试
					</p>
				) : (
					<FocusDashboard client:load todayKey={todayKey} />
				)
			}
		</div>
	</div>
	<FocusTip />
</MainGridLayout>
