---
import { siteConfig } from "../config";
import { focusStats } from "../data/focus-stats";
import MainGridLayout from "../layouts/MainGridLayout.astro";

export const prerender = true;

if (!siteConfig.featurePages.focus) {
	return Astro.redirect("/404/");
}

const { totalMinutes, totalSessions, activeDays, days, updatedAt } = focusStats;
const totalHours = (totalMinutes / 60).toFixed(1);

// 拼一份「最近 26 周」的热力图格子：7 行(周日~周六) x 26 列(周)
const WEEKS = 26;
const pad2 = (n: number) => String(n).padStart(2, "0");
const keyOf = (d: Date) => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;

const today = new Date();
today.setHours(0, 0, 0, 0);
const endOfWeek = new Date(today);
endOfWeek.setDate(endOfWeek.getDate() + (6 - endOfWeek.getDay())); // 补到本周六
const startDate = new Date(endOfWeek);
startDate.setDate(startDate.getDate() - WEEKS * 7 + 1);

const cells: { date: string; minutes: number }[] = [];
for (let i = 0; i < WEEKS * 7; i++) {
	const d = new Date(startDate);
	d.setDate(d.getDate() + i);
	cells.push({ date: keyOf(d), minutes: days[keyOf(d)] ?? 0 });
}
const maxMinutes = Math.max(1, ...cells.map((c) => c.minutes));
function levelOf(minutes: number) {
	if (!minutes) return 0;
	const ratio = minutes / maxMinutes;
	if (ratio > 0.75) return 4;
	if (ratio > 0.5) return 3;
	if (ratio > 0.25) return 2;
	return 1;
}
// --color-primary-rgb 在这套主题里其实没定义（唯一用到它的 devices.astro 页面本身是关着的，
// 这个坑一直没暴露）。--primary 是 oklch()，rgba() 没法直接吃，所以用 opacity 属性做透明度分级，
// 这样不管主题色是什么色彩空间都能用。level 0（没数据）走一个中性底色，跟其余等级区分开。
const LEVEL_OPACITY = [0, 0.3, 0.55, 0.75, 1];

const monthLabels: { col: number; label: string }[] = [];
let lastMonth = -1;
for (let w = 0; w < WEEKS; w++) {
	const d = cells[w * 7].date;
	const m = Number(d.slice(5, 7));
	if (m !== lastMonth) {
		monthLabels.push({ col: w, label: `${m}月` });
		lastMonth = m;
	}
}

const updatedLabel = updatedAt
	? new Date(updatedAt).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })
	: null;
---

<MainGridLayout title="专注统计" description="按天记录的专注时长热力图">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<div class="flex flex-col items-start justify-center mb-6">
				<h1
					class="text-3xl sm:text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)] before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
				>
					🎯 专注统计
				</h1>
				<p class="text-black/50 dark:text-white/50 text-sm sm:text-base">
					{updatedLabel ? `最后更新于 ${updatedLabel}` : "还没有同步过数据"}
				</p>
			</div>

			<div class="grid grid-cols-3 gap-4 mb-8">
				<div class="rounded-xl bg-[var(--btn-regular-bg)] p-4 sm:p-5 text-center">
					<div class="text-2xl sm:text-3xl font-bold text-[var(--primary)]">{totalHours}</div>
					<div class="text-xs sm:text-sm text-black/50 dark:text-white/50 mt-1">总时长（小时）</div>
				</div>
				<div class="rounded-xl bg-[var(--btn-regular-bg)] p-4 sm:p-5 text-center">
					<div class="text-2xl sm:text-3xl font-bold text-[var(--primary)]">{totalSessions}</div>
					<div class="text-xs sm:text-sm text-black/50 dark:text-white/50 mt-1">专注次数</div>
				</div>
				<div class="rounded-xl bg-[var(--btn-regular-bg)] p-4 sm:p-5 text-center">
					<div class="text-2xl sm:text-3xl font-bold text-[var(--primary)]">{activeDays}</div>
					<div class="text-xs sm:text-sm text-black/50 dark:text-white/50 mt-1">活跃天数</div>
				</div>
			</div>

			<div class="overflow-x-auto pb-2">
				<div class="min-w-[560px]">
					<div class="grid gap-[3px] mb-1 relative h-4" style={`grid-template-columns:repeat(${WEEKS},1fr)`}>
						{monthLabels.map((m) => (
							<span
								class="text-[10px] text-black/40 dark:text-white/40 absolute"
								style={`left:calc(${m.col} / ${WEEKS} * 100%)`}
							>
								{m.label}
							</span>
						))}
					</div>
					<div class="grid grid-flow-col gap-[3px]" style={`grid-template-rows:repeat(7,1fr);grid-template-columns:repeat(${WEEKS},1fr)`}>
						{cells.map((c) => {
							const level = levelOf(c.minutes);
							const style =
								level === 0
									? "background:var(--btn-regular-bg)"
									: `background:var(--primary);opacity:${LEVEL_OPACITY[level]}`;
							return <div class="aspect-square rounded-[2px]" style={style} title={`${c.date} · ${c.minutes} 分钟`} />;
						})}
					</div>
				</div>
			</div>

			<div class="flex items-center gap-2 mt-4 text-xs text-black/40 dark:text-white/40">
				<span>少</span>
				{LEVEL_OPACITY.map((op, level) => (
					<span
						class="w-3 h-3 rounded-[2px] inline-block"
						style={level === 0 ? "background:var(--btn-regular-bg)" : `background:var(--primary);opacity:${op}`}
					/>
				))}
				<span>多</span>
			</div>

			{totalSessions === 0 && (
				<p class="text-center text-black/40 dark:text-white/40 text-sm mt-10">
					数据还是空的——去 Obsidian 私有笔记里点「同步到博客公开统计页」试试
				</p>
			)}
		</div>
	</div>
</MainGridLayout>
